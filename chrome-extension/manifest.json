{
  "manifest_version": 3,
  "name": "은행 모드",
  "version": "1.0.2",
  "description": "은행 보안 프로그램을 크롬 버튼 하나로 켜고 끕니다. 은행 모드(BankMode) 앱이 필요해요.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "*://*.banking.nonghyup.com/*",
    "*://*.gov.kr/*",
    "*://*.hometax.go.kr/*",
    "*://*.ibk.co.kr/*",
    "*://*.kbstar.com/*",
    "*://*.kebhana.com/*",
    "*://*.shinhan.com/*",
    "*://*.wooribank.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "은행 모드",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
