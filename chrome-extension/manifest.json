{
  "manifest_version": 3,
  "name": "은행 모드",
  "version": "1.0.1",
  "description": "은행 보안 프로그램을 크롬 버튼 하나로 켜고 끕니다. 은행 모드(BankMode) 앱이 필요해요.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": [
    "*://*.kbstar.com/*",
    "*://*.shinhan.com/*",
    "*://*.wooribank.com/*",
    "*://*.kebhana.com/*",
    "*://*.hanabank.com/*",
    "*://*.ibk.co.kr/*",
    "*://*.nonghyup.com/*",
    "*://*.nhbank.com/*",
    "*://*.standardchartered.co.kr/*",
    "*://*.citibank.co.kr/*",
    "*://*.imbank.co.kr/*",
    "*://*.busanbank.co.kr/*",
    "*://*.knbank.co.kr/*",
    "*://*.kjbank.com/*",
    "*://*.jbbank.co.kr/*",
    "*://*.suhyup-bank.com/*",
    "*://*.kfcc.co.kr/*",
    "*://*.cu.co.kr/*",
    "*://*.epostbank.go.kr/*",
    "*://*.kdb.co.kr/*",
    "*://*.kbanknow.com/*",
    "*://*.kakaobank.com/*",
    "*://*.tossbank.com/*",
    "*://*.kiwoom.com/*",
    "*://*.miraeasset.com/*",
    "*://*.samsungpop.com/*",
    "*://*.kbsec.com/*",
    "*://*.truefriend.com/*",
    "*://*.nhqv.com/*",
    "*://*.hanaw.com/*",
    "*://*.hometax.go.kr/*",
    "*://*.gov.kr/*",
    "*://*.nhis.or.kr/*",
    "*://*.customs.go.kr/*",
    "*://*.wetax.go.kr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "은행 모드",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
